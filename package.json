{
    "title": "Creative",
    "name": "startbootstrap-creative",
    "version": "6.0.1",
    "scripts": {
        "build": "npm run clean && npm run build:scss && npm run build:scripts",
        "build:assets": "node scripts/build-assets.js",
        "build:pug": "node scripts/build-pug.js",
        "build:scripts": "node scripts/build-scripts.js",
        "build:scss": "node scripts/build-scss.js",
        "clean": "node scripts/clean.js",
        "start": "npm run build:scss && npm run build:scripts",
        "start:debug": "npm run build && node scripts/start-debug.js",
        "dev": "concurrently \"npm run watch\" \"npm run serve\"",
        "watch": "nodemon --watch src -e scss,js,pug --exec \"npm run build\"",
        "serve": "browser-sync dist -w --no-online"
    },
    "description": "Creative is a stylish one page HTML theme built with Bootstrap.",
    "keywords": [
        "css",
        "sass",
        "scss",
        "html",
        "pug",
        "responsive",
        "theme",
        "template"
    ],
    "homepage": "https://startbootstrap.com/themes/creative",
    "bugs": {
        "url": "https://github.com/BlackrockDigital/startbootstrap-creative/issues",
        "email": "feedback@startbootstrap.com"
    },
    "license": "MIT",
    "author": "Start Bootstrap",
    "contributors": [
        "David Miller (http://davidmiller.io/)"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/BlackrockDigital/startbootstrap-creative.git"
    },
    "dependencies": {
        "bootstrap": "^5.3.2",
        "@popperjs/core": "^2.11.8"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.16",
        "browser-sync": "^2.29.3",
        "chokidar": "^3.5.3",
        "concurrently": "^8.2.2",
        "cssnano": "^6.0.1",
        "nodemon": "^3.0.2",
        "postcss": "^8.4.32",
        "postcss-cli": "^11.1.0",
        "prettier": "^3.1.1",
        "pug": "^3.0.2",
        "sass": "^1.69.5",
        "shelljs": "^0.8.5",
        "upath": "^2.0.1"
    }
}
